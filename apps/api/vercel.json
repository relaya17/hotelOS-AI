{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@hotelos/api^...",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --prod=false",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [
    {
      "path": "/v1/cron/cio-daily",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/v1/cron/cfo-daily",
      "schedule": "15 5 * * *"
    },
    {
      "path": "/v1/cron/anomaly-scan",
      "schedule": "30 */6 * * *"
    },
    {
      "path": "/v1/cron/notification-outbox",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/v1/cron/knowledge-reindex",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/v1/cron/trusted-sources-refresh",
      "schedule": "30 4 * * *"
    }
  ]
}
