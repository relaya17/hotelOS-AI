# Copy to apps/api/.env and fill in (never commit .env).
# Local API loads this file first, then falls back to repo-root .env.

NODE_ENV=development
API_PORT=3001
LOG_LEVEL=info

JWT_ACCESS_SECRET=change-me-access-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-min-16-chars

# Local file DB:
# DATABASE_URL=file:.data/hotelos.sqlite
# DATABASE_AUTH_TOKEN=

# Turso (production / Vercel) — paste from app.turso.tech:
DATABASE_URL=libsql://hotelos-prod-XXXX.aws-eu-west-1.turso.io
DATABASE_AUTH_TOKEN=

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://*.vercel.app
RECORDINGS_PATH=.data/recordings
# Optional: Vercel Blob read/write token — when set, Meet recordings use Blob instead of disk (required on Vercel). Leave empty for local dev.
BLOB_READ_WRITE_TOKEN=
NODEJS_HELPERS=0

# WhatsApp delivery: demo (safe default) | http | meta | off
WHATSAPP_PROVIDER=demo
# http: POST JSON { to: E.164, body } + Bearer token (any 2xx = success)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# meta (Cloud API): token = Graph permanent/system user token
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_GRAPH_VERSION=v21.0
# Optional approved template for cold room invites ({{1}}=guest name, {{2}}=room)
WHATSAPP_META_TEMPLATE_NAME=
WHATSAPP_META_TEMPLATE_LANGUAGE=he
# Cron /v1/cron/notification-outbox retries pending/failed every 10m when CRON_SECRET is set.

# PMS for Digital Twin: demo | mews_stub | opera_stub | mews
PMS_PROVIDER=demo
# Required when PMS_PROVIDER=mews
MEWS_CLIENT_TOKEN=
MEWS_ACCESS_TOKEN=
MEWS_PLATFORM_URL=https://api.mews-demo.com
MEWS_CLIENT_NAME=HotelOS AI 1.0
# Optional: Bearer / X-HotelOS-Pms-Secret for POST /v1/public/pms/inbound
PMS_INBOUND_SECRET=

# Payments (PCI: card PAN never stored in HotelOS)
# demo | stripe_stub | external
PAYMENT_PROVIDER=demo
# Required when PAYMENT_PROVIDER=external
PAYMENT_EXTERNAL_URL=
PAYMENT_EXTERNAL_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/v1/trust/oauth/google/callback
GOOGLE_POST_LOGIN_REDIRECT=http://localhost:5173/
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=HotelOS AI

AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://api.openai.com/v1
AI_GATEWAY_MODEL=gpt-4o-mini
