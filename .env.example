NODE_ENV=development
API_PORT=3001
LOG_LEVEL=info
JWT_ACCESS_SECRET=change-me-access-dev-only
JWT_REFRESH_SECRET=change-me-refresh-dev-only
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
## Local dev: keep the file: URL (same on-disk sqlite file as before).
## Production: point at a hosted Turso DB, e.g. libsql://hotelos-prod.turso.io
DATABASE_URL=file:.data/hotelos.sqlite
## Required only when DATABASE_URL is a libsql:// (Turso) URL
DATABASE_AUTH_TOKEN=
RECORDINGS_PATH=.data/recordings
## Optional: Vercel Blob read/write token — when set, Meet recordings use Blob (required on Vercel); leave empty for local disk under RECORDINGS_PATH
BLOB_READ_WRITE_TOKEN=
## Optional: enables POST /v1/cron/* (Vercel Cron Authorization: Bearer …)
CRON_SECRET=
## Optional: Sentry (or GlitchTip) DSN for API — leave empty to disable
SENTRY_DSN=
SENTRY_ENVIRONMENT=
## Sentry webhook → IT tasks (POST /v1/public/sentry/ingest). Required in production.
SENTRY_INGEST_SECRET=
## Optional fallback hotel UUID when Sentry events lack hotelId tag (prefer SDK tags)
SENTRY_DEFAULT_HOTEL_ID=
## Optional: browser Sentry for Vite apps (admin / executive / guest / work)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
## PMS for Digital Twin: demo | mews_stub | opera_stub | mews
PMS_PROVIDER=demo
## Required when PMS_PROVIDER=mews (Mews Connector API tokens)
MEWS_CLIENT_TOKEN=
MEWS_ACCESS_TOKEN=
MEWS_PLATFORM_URL=https://api.mews-demo.com
MEWS_CLIENT_NAME=HotelOS AI 1.0
## Optional secret for POST /v1/public/pms/inbound (channel → HotelOS)
PMS_INBOUND_SECRET=
## Payments: demo | stripe_stub | external (PAN never touches HotelOS)
PAYMENT_PROVIDER=demo
PAYMENT_EXTERNAL_URL=
PAYMENT_EXTERNAL_TOKEN=
## WhatsApp delivery: demo (safe default) | http | meta | off
WHATSAPP_PROVIDER=demo
## http: POST { to: E.164, body } + Bearer token
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
## meta Cloud API (reuse WHATSAPP_API_TOKEN as Graph token)
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_GRAPH_VERSION=v21.0
WHATSAPP_META_TEMPLATE_NAME=
WHATSAPP_META_TEMPLATE_LANGUAGE=he
## Optional E.164 recipient for CIO daily digest WhatsApp copy (empty = in-app only)
DIGEST_WHATSAPP_TO=
## VMS public webhook secret (Bearer / X-HotelOS-Security-Secret). Required in production.
SECURITY_INGEST_SECRET=
## Required on Vercel API project for Hono (see apps/api/api/index.ts)
NODEJS_HELPERS=0
## Local: three Vite apps. Production API: add https://*.vercel.app (or exact URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,https://*.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/v1/trust/oauth/google/callback
GOOGLE_POST_LOGIN_REDIRECT=http://localhost:5173/
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=HotelOS AI
## Demo Google login + demo tenant seed: empty = on in development/test, off in production
## Set true/false to force. Never enable demo auth on a real production deployment.
ALLOW_DEMO_AUTH=
ALLOW_DEMO_SEED=
## AI Gateway — leave empty for deterministic provider; set key for OpenAI-compatible LLM
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://api.openai.com/v1
AI_GATEWAY_MODEL=gpt-4o-mini
AI_GATEWAY_EMBED_MODEL=text-embedding-3-small
